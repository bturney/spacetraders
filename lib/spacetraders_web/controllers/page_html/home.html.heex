<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%= if @current_scope do %>
    <div>
      <div class="flex items-center justify-between">
        <div>
          <.header>
            Welcome, {@current_scope.operator.email}
            <:subtitle>
              Your agents. Credits, fleet and missions land here in the next milestone.
            </:subtitle>
          </.header>
        </div>
        <.link navigate={~p"/agents/new"} class="btn btn-primary">
          Mint an agent
        </.link>
      </div>

      <div :if={@agents == []} class="alert alert-outline mt-8">
        <span>
          You haven't minted any agents yet. <.link
            navigate={~p"/agents/new"}
            class="font-semibold underline"
          >Mint your first agent</.link>.
        </span>
      </div>

      <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <li :for={agent <- @agents} class="card bg-base-200 p-4">
          <div class="flex items-center justify-between">
            <span class="font-mono font-semibold">{agent.symbol}</span>
            <span class="badge badge-outline">{agent.faction}</span>
          </div>
          <p class="mt-2 text-sm opacity-70">
            HQ: <span class="font-mono">{agent.headquarters}</span>
          </p>
        </li>
      </ul>
    </div>
  <% else %>
    <div class="mx-auto max-w-lg text-center py-16">
      <h1 class="text-4xl font-bold tracking-tight">SpaceTraders dashboard</h1>
      <p class="mt-4 text-lg opacity-80">
        Drive your fleet and missions from the browser. Log in or register to get started.
      </p>
      <div class="mt-10 flex justify-center gap-4">
        <.link href={~p"/operators/log-in"} class="btn btn-primary">Log in</.link>
        <.link href={~p"/operators/register"} class="btn btn-soft">Register</.link>
      </div>
    </div>
  <% end %>
</Layouts.app>
