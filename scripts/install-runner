#!/usr/bin/env bash
# Run as root on project-host. The final registration command is intentionally
# interactive because a GitHub registration token is short-lived.
set -euo pipefail

readonly RUNNER_USER=spacetraders-runner
readonly RUNNER_DIR=/opt/actions-runner
readonly DEPLOY_DIR=/srv/projects/spacetraders
readonly REPOSITORY=https://github.com/bturney/spacetraders
readonly RUNNER_VERSION=2.330.0
readonly RUNNER_ARCH=x64
readonly RUNNER_SHA256=af5c33fa94f3cc33b8e97937939136a6b04197e6dadfcfb3b6e33ae1bf41e79a
readonly DEPLOY_SCRIPT_URL=https://raw.githubusercontent.com/bturney/spacetraders/2bdf4343602e6390ed780b9fe4f60551a271abef/scripts/deploy-host
readonly DEPLOY_SCRIPT_SHA256=7c46dfbace25f1e8e1148acfb10ee6b7a5131952866f220e4d886bf0331c1302

[[ $EUID -eq 0 ]] || { printf '%s\n' 'Run this script as root.' >&2; exit 1; }
[[ -d "$DEPLOY_DIR" ]] || { printf '%s\n' "$DEPLOY_DIR does not exist." >&2; exit 1; }

id -u "$RUNNER_USER" >/dev/null 2>&1 || useradd --create-home --shell /bin/bash "$RUNNER_USER"
usermod -aG docker "$RUNNER_USER"

install -d -o "$RUNNER_USER" -g "$RUNNER_USER" "$RUNNER_DIR"
curl --fail --location --silent --show-error "$DEPLOY_SCRIPT_URL" --output /tmp/spacetraders-deploy
printf '%s  %s\n' "$DEPLOY_SCRIPT_SHA256" /tmp/spacetraders-deploy | sha256sum --check --status
install -o root -g docker -m 0750 /tmp/spacetraders-deploy "$DEPLOY_DIR/deploy"
rm /tmp/spacetraders-deploy
chgrp -R docker "$DEPLOY_DIR"
chmod 0750 "$DEPLOY_DIR" "$DEPLOY_DIR/deploy"
chmod 0640 "$DEPLOY_DIR/.env"
chgrp docker "$DEPLOY_DIR/.env"
touch "$DEPLOY_DIR/.current-image" "$DEPLOY_DIR/.previous-image"
chown "$RUNNER_USER:docker" "$DEPLOY_DIR/.current-image" "$DEPLOY_DIR/.previous-image"
chmod 0660 "$DEPLOY_DIR/.current-image" "$DEPLOY_DIR/.previous-image"

if [[ ! -x "$RUNNER_DIR/run.sh" ]]; then
  archive="actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz"
  curl --fail --location --silent --show-error \
    "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/${archive}" \
    --output "/tmp/${archive}"
  printf '%s  %s\n' "$RUNNER_SHA256" "/tmp/${archive}" | sha256sum --check --status
  tar --extract --gzip --file "/tmp/${archive}" --directory "$RUNNER_DIR"
  rm "/tmp/${archive}"
  chown -R "$RUNNER_USER:$RUNNER_USER" "$RUNNER_DIR"
fi

printf '%s\n' 'Runner files and host deploy routine are installed.'
printf '%s\n' 'Run this single command as an authenticated GitHub operator to register and start the runner:'
printf 'TOKEN=$(gh api --method POST repos/bturney/spacetraders/actions/runners/registration-token --jq .token) && sudo -u %s %s/config.sh --unattended --url %s --token "$TOKEN" --labels project-host --name project-host && sudo %s/svc.sh install %s && sudo %s/svc.sh start\n' \
  "$RUNNER_USER" "$RUNNER_DIR" "$REPOSITORY" "$RUNNER_DIR" "$RUNNER_USER" "$RUNNER_DIR"
