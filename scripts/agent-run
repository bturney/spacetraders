#!/usr/bin/env bash
# Execute the complete unattended lifecycle for one runner-assigned task.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -z "${AGENT_TASK_ID:-}" || -z "${AGENT_ATTEMPT:-}" ]]; then
  source "$SCRIPT_DIR/_agent_context.sh"
  agent_context_invalid_result "runner/missing_task_identity"
  echo "AGENT_TASK_ID and AGENT_ATTEMPT are required runner inputs." >&2
  exit 64
fi

source "$SCRIPT_DIR/_agent_context.sh"
if ! agent_context_require; then
  agent_context_invalid_result "$AGENT_CONTEXT_FAILURE_CLASS"
  exit 64
fi

if [ -e "$AGENT_ARTIFACT_DIR/input.json" ]; then
  echo "Attempt $AGENT_TASK_ID/$AGENT_ATTEMPT already has evidence; allocate a new attempt." >&2
  exit 73
fi

run_status=1
failure_class="execution/unclassified"
export AGENT_STARTED_EPOCH="$(date +%s)"

cleanup() {
  local status=$?
  if [ "$status" -eq 0 ]; then
    run_status=0
    failure_class=""
  fi

  set +e
  AGENT_RUN_STATUS="$run_status" AGENT_FAILURE_CLASS="$failure_class" "$SCRIPT_DIR/agent-teardown.sh"
  local teardown_status=$?
  set -e
  if [ "$status" -eq 0 ] && [ "$teardown_status" -ne 0 ]; then
    exit "$teardown_status"
  fi

  exit "$status"
}

trap cleanup EXIT
"$SCRIPT_DIR/agent-bootstrap.sh" || {
  run_status=$?
  failure_class="provision/bootstrap_failed"
  exit "$run_status"
}
"$SCRIPT_DIR/agent-verify.sh" || {
  run_status=$?
  failure_class="prove/verification_failed"
  exit "$run_status"
}
