#!/usr/bin/env bash
# Installed on project-host as /srv/projects/spacetraders/deploy.
set -euo pipefail

readonly DEPLOY_DIR=/srv/projects/spacetraders
readonly BUNDLE_DIR=${SPACETRADERS_BUNDLE_DIR:-$DEPLOY_DIR}
readonly STATE_FILE="$DEPLOY_DIR/.current-image"
readonly PREVIOUS_STATE_FILE="$DEPLOY_DIR/.previous-image"
readonly HEALTH_URL=http://127.0.0.1:4000/health

cd "$DEPLOY_DIR"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

compose() {
  local image=$1
  shift
  SPACETRADERS_IMAGE="$image" docker compose --project-name spacetraders \
    --env-file "$DEPLOY_DIR/.env" \
    -f "$BUNDLE_DIR/compose.yaml" \
    -f "$BUNDLE_DIR/compose.production.yaml" "$@"
}

validate_image() {
  local image=$1
  local resolved
  local expected
  resolved=$(compose "$image" config --images | sort -u)
  expected=$(printf '%s\n%s\n' "$image" postgres:17-alpine | sort -u)
  [[ "$resolved" == "$expected" ]] || die "Compose did not resolve the requested images."
}

health_check() {
  local response
  response=$(curl --fail --silent --show-error --retry 10 --retry-all-errors --retry-connrefused \
    --retry-delay 1 --connect-timeout 5 --max-time 10 "$HEALTH_URL") || return 1
  [[ "$response" == '{"status":"ok"}' ]]
}

postgres_authority_state() {
  local image=$1
  local table
  local authority

  table=$(compose "$image" exec -T postgres sh -c \
    'psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --tuples-only --no-align --command "SELECT to_regclass('\''public.runtime_authority'\'')"' \
    2>/dev/null) || {
    printf '%s\n' unknown
    return
  }

  if [[ "$table" != runtime_authority ]]; then
    printf '%s\n' pre_cutover
    return
  fi

  authority=$(compose "$image" exec -T postgres sh -c \
    'psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --tuples-only --no-align --command "SELECT CASE WHEN count(*) = 0 THEN NULL WHEN count(*) = 1 THEN min(store) ELSE '\''invalid'\'' END FROM runtime_authority WHERE name = '\''durable_truth'\''"' \
    2>/dev/null) || {
    printf '%s\n' unknown
    return
  }

  case "$authority" in
    postgresql) printf '%s\n' postgresql ;;
    '') printf '%s\n' pre_cutover ;;
    *) printf '%s\n' unknown ;;
  esac
}

running_image() {
  docker inspect --format '{{.Config.Image}}' spacetraders-web-1 2>/dev/null
}

rollback_candidate_before_deploy() {
  if [[ -s "$STATE_FILE" ]]; then
    <"$STATE_FILE"
  else
    running_image
  fi
}

recorded_rollback_image() {
  [[ -s "$PREVIOUS_STATE_FILE" ]] && <"$PREVIOUS_STATE_FILE"
}

record_success() {
  local image=$1
  local previous=$2
  if [[ -n "$previous" && "$previous" != "$image" ]]; then
    printf '%s\n' "$previous" >"$PREVIOUS_STATE_FILE"
  fi
  printf '%s\n' "$image" >"$STATE_FILE"
}

restore() {
  local image=$1
  validate_image "$image"
  compose "$image" pull
  compose "$image" up -d
  health_check || die "Rollback health check failed."
  printf '%s\n' "$image" >"$STATE_FILE"
}

deploy_image() {
  local image=$1
  local previous=${2:-}

  validate_image "$image"
  compose "$image" pull
  compose "$image" stop web

  if compose "$image" up -d && health_check; then
    record_success "$image" "$previous"
    return
  fi

  if [[ -z "$previous" || "$previous" == "$image" ]]; then
    die "Deployment failed; no previous image is available for rollback."
  fi

  case "$(postgres_authority_state "$image")" in
    postgresql)
      die "Deployment failed after PostgreSQL authority advanced; recover forward with a fixed image."
      ;;
    unknown)
      die "Deployment failed and PostgreSQL authority could not be disproved; refusing rollback."
      ;;
  esac

  printf '%s\n' "Deployment failed; rolling back." >&2
  restore "$previous"
  die "Deployment failed; rollback completed."
}

case "${1:-}" in
  deploy)
    [[ $# -eq 2 ]] || die "Usage: deploy deploy <image-ref>"
    deploy_image "$2" "$(rollback_candidate_before_deploy || true)"
    ;;
  rollback)
    [[ $# -eq 1 ]] || die "Usage: deploy rollback"
    [[ -s "$STATE_FILE" ]] || die "No current image is recorded."
    current=$(<"$STATE_FILE")
    case "$(postgres_authority_state "$current")" in
      postgresql)
        die "PostgreSQL authority has advanced; image rollback is disabled. Recover forward."
        ;;
      unknown)
        die "PostgreSQL authority could not be disproved; refusing rollback."
        ;;
    esac
    previous=$(recorded_rollback_image) || die "No previous image is available for rollback."
    restore "$previous"
    printf '%s\n' "$current" >"$PREVIOUS_STATE_FILE"
    ;;
  *)
    die "Usage: deploy {deploy <image-ref>|rollback}"
    ;;
esac
