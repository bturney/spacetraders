#!/usr/bin/env bash
# Teardown for the spacetraders project.
#
# Stops any running BEAM server process rooted at this checkout and removes
# build artifacts and local SQLite databases. Deps are shared across checkouts
# under the toolchain dir (see _toolchain.sh) and are left in place.
# Does not remove the installed Erlang/Elixir toolchain (that lives outside the checkout).
#
# Usage: scripts/teardown
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/_toolchain.sh"

# Stop a running Phoenix/Bandit server (beam) whose CWD is this checkout.
for pid in $(pgrep -f 'beam\.smp' 2>/dev/null || true); do
  if [ -r "/proc/$pid/cwd" ] && [ "$(readlink "/proc/$pid/cwd" 2>/dev/null || true)" = "$PROJECT_ROOT" ]; then
    echo "Stopping beam server pid $pid"
    kill "$pid" 2>/dev/null || true
  fi
done

# Wait briefly for the server to release the SQLite files.
sleep 1

rm -rf "$PROJECT_ROOT/_build" "$PROJECT_ROOT/deps"
rm -rf "$PROJECT_ROOT/priv/static/assets"
rm -f "$PROJECT_ROOT"/*.db "$PROJECT_ROOT"/*.db-*

if [ "${WORKTREE_PORT_LEASE:-0}" = 1 ] && [ -n "${AGENT_TASK_ID:-}" ]; then
  "$SCRIPT_DIR/worktree-release-port" "$AGENT_TASK_ID"
fi

rm -f "$PROJECT_ROOT/.worktree-env"
rm -rf "$PROJECT_ROOT/.worktree-mix"

echo "Teardown complete."
