#!/usr/bin/env bash
# Canonical project verification gate.
#
# Runs `mix verify` (format check, warnings-as-errors compile, tests, and a
# real app boot + GET /health). This is the same gate CI runs.
#
# Usage: scripts/verify
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_toolchain.sh"

if command -v mix >/dev/null 2>&1; then
  MIX=mix
elif [ -x "$ELIXIR_DIR/bin/mix" ]; then
  MIX="$ELIXIR_DIR/bin/mix"
  export PATH="$ELIXIR_DIR/bin:$OTP_DIR/bin:$PATH"
else
  echo "No Elixir toolchain found. Run scripts/bootstrap first." >&2
  exit 1
fi

# Cheap insurance for a fresh or partial checkout: fetch deps only when they are
# missing so steady-state runs stay quiet (deps.get lists every locked package
# and its security advisories). On failure the resolver output is surfaced.
if [ ! -d deps ] || [ -z "$(ls -A deps 2>/dev/null)" ]; then
  deps_log="$(mktemp)"
  if ! "$MIX" deps.get >"$deps_log" 2>&1; then
    echo "mix deps.get failed:" >&2
    cat "$deps_log" >&2
    rm -f "$deps_log"
    exit 1
  fi
  rm -f "$deps_log"
fi

"$MIX" verify
