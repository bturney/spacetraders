#!/usr/bin/env bash
# Prepare one checkout for concurrent ticket work.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
requested_port="${PORT:-}"
requested_database="${SPACETRADERS_TEST_DATABASE:-}"
if [ -f "$PROJECT_ROOT/.worktree-env" ]; then
  echo "This worktree already has task configuration. Run scripts/teardown before configuring it again." >&2
  exit 73
fi
source "$SCRIPT_DIR/_toolchain.sh"
cd "$PROJECT_ROOT"

task_id="${1:-${AGENT_TASK_ID:-}}"
if [[ -z "$task_id" ]]; then
  echo "Usage: scripts/worktree-setup <stable-task-id>" >&2
  exit 64
fi

if [[ ! "$task_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "Task ID must begin with a letter or digit and may then contain periods, underscores, or hyphens." >&2
  exit 64
fi

# Each task gets a database allocation named after the task, so concurrent
# checkouts remain isolated and teardown can release the task's allocation.
#
# `spacetraders_test_` + the task ID is injective: the task ID already admits
# only [A-Za-z0-9._-], every one of which PostgreSQL accepts in an unquoted
# database name and none of which carry meaning in a connection URL. The only
# remaining constraint is PostgreSQL's 63-byte identifier limit.
readonly DATABASE_PREFIX="spacetraders_test_"
readonly DATABASE_MAX_BYTES=63
readonly TASK_ID_MAX_BYTES=$((DATABASE_MAX_BYTES - ${#DATABASE_PREFIX}))

if [ -n "$requested_database" ]; then
  if [ "${#requested_database}" -gt "$DATABASE_MAX_BYTES" ] ||
    [[ ! "$requested_database" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]; then
    echo "SPACETRADERS_TEST_DATABASE must be a PostgreSQL identifier of at most $DATABASE_MAX_BYTES bytes, beginning with a letter or underscore." >&2
    exit 64
  fi
  database="$requested_database"
else
  if [ "${#task_id}" -gt "$TASK_ID_MAX_BYTES" ]; then
    echo "Task ID must be at most $TASK_ID_MAX_BYTES bytes so its test database name fits PostgreSQL's $DATABASE_MAX_BYTES-byte identifier limit." >&2
    exit 64
  fi
  database="$DATABASE_PREFIX$task_id"
fi

# Only the database name is per-task. Host, port, and credentials come from the
# caller's DATABASE_URL when it has one — CI pins a job-level value — so this
# changes which database is used, never which server. A bare checkout without
# DATABASE_URL keeps the gate's own default.
database_url="${DATABASE_URL:-postgres://postgres:postgres@localhost/spacetraders_test}"
database_url="${database_url%/*}/$database"

if ! command -v flock >/dev/null 2>&1; then
  echo "Missing runner prerequisite: flock (util-linux) is required for worktree setup." >&2
  exit 1
fi

export MIX_DEPS_PATH="$PROJECT_ROOT/deps"
export MIX_BUILD_PATH="$PROJECT_ROOT/_build"
export MIX_HOME="$PROJECT_ROOT/.worktree-mix"

cache_root="${SPACETRADERS_WORKTREE_CACHE_DIR:-$TOOLCHAIN_DIR/worktree-cache}"
port_root="${SPACETRADERS_PORT_REGISTRY_DIR:-$TOOLCHAIN_DIR/worktree-ports}"
mkdir -p "$cache_root/entries" "$cache_root/locks" "$port_root"
exec 7>"$cache_root/prune.lock"
flock -s 7

allocate_port() {
  local registry="$port_root/registry.tsv"
  local port hash candidate offset

  if [ -n "$requested_port" ]; then
    if [[ ! "$requested_port" =~ ^[1-9][0-9]{0,4}$ ]] || [ "$requested_port" -gt 65535 ]; then
      echo "PORT must be an integer from 1 through 65535." >&2
      exit 64
    fi
    printf '%s\n' "$requested_port"
    return
  fi

  exec 8>"$port_root/registry.lock"
  flock 8

  if awk -F '\t' -v task="$task_id" '$1 == task { found = 1 } END { exit !found }' "$registry" 2>/dev/null; then
    echo "Task ID $task_id already owns a port. Set PORT explicitly to override it." >&2
    exit 73
  fi

  hash="$(printf '%s' "$task_id" | cksum | cut -d ' ' -f 1)"
  candidate=$((41000 + hash % 10000))

  for offset in $(seq 0 9999); do
    port=$((41000 + (candidate - 41000 + offset) % 10000))
    if ! awk -F '\t' -v port="$port" '$2 == port { found = 1 } END { exit !found }' "$registry" 2>/dev/null; then
      printf '%s\t%s\n' "$task_id" "$port" >> "$registry"
      printf '%s\n' "$port"
      return
    fi
  done

  echo "No worktree ports remain in the 41000-50999 allocation range." >&2
  exit 75
}

port="$(allocate_port)"
port_lease=1
if [ -n "$requested_port" ]; then port_lease=0; fi
# An explicitly named database belongs to whoever named it, not to this task's
# lease, so teardown leaves it alone — the same rule the requested-port
# override follows.
database_lease=1
if [ -n "$requested_database" ]; then database_lease=0; fi
setup_complete=0

# Bootstrap and compile are slow and chatty; stream a single progress line and
# keep the full output in a log artifact, dumping its tail only on failure.
quiet_bootstrap() {
  local log="$1" progress="$2"

  echo "$progress (full output: $log)"

  if ! (
    "$SCRIPT_DIR/bootstrap" &&
    export PATH="$ELIXIR_DIR/bin:$OTP_DIR/bin:$PATH" &&
    "$ELIXIR_DIR/bin/mix" compile
  ) >"$log" 2>&1; then
    echo "Worktree setup failed; last 80 lines of $log:" >&2
    tail -n 80 "$log" >&2
    exit 1
  fi
}

# Warm-cache entries carry deps and _build only; MIX_HOME (Hex/Rebar archives)
# lives outside them, so a restored checkout may still be missing the package
# manager. Install silently when absent instead of prompting mid-command.
ensure_mix_home() {
  mkdir -p "$MIX_HOME"

  if [ ! -e "$MIX_HOME/archives/hex.ez" ]; then
    "$ELIXIR_DIR/bin/mix" local.hex --if-missing --force
  fi

  if [ ! -e "$MIX_HOME/rebar3" ]; then
    "$ELIXIR_DIR/bin/mix" local.rebar --if-missing --force
  fi
}

cleanup_failed_setup() {
  if [ "$setup_complete" -eq 0 ] && [ "$port_lease" -eq 1 ] &&
    [ ! -f "$PROJECT_ROOT/.worktree-env" ]; then
    "$SCRIPT_DIR/worktree-release-port" "$task_id"
  fi
}
trap cleanup_failed_setup EXIT

clean_worktree() {
  git -C "$PROJECT_ROOT" diff --quiet &&
    git -C "$PROJECT_ROOT" diff --cached --quiet &&
    [ -z "$(git -C "$PROJECT_ROOT" ls-files --others --exclude-standard)" ]
}

if clean_worktree; then
  revision="$(git -C "$PROJECT_ROOT" rev-parse HEAD)"
  lockfile_digest="$(sha256sum "$PROJECT_ROOT/mix.lock" | cut -d ' ' -f 1)"
  cache_key="$(printf '%s\n%s\n%s\n%s\n' "$revision" "$lockfile_digest" "$OTP_VERSION" "$ELIXIR_VERSION" | sha256sum | cut -d ' ' -f 1)"
  cache_entry="$cache_root/entries/$cache_key"

  exec 9>"$cache_root/locks/$cache_key.lock"
  flock 9

  if [ -f "$cache_entry/complete" ]; then
    rm -rf "$PROJECT_ROOT/deps" "$PROJECT_ROOT/_build"
    mkdir -p "$PROJECT_ROOT/deps" "$PROJECT_ROOT/_build"
    cp -a "$cache_entry/deps/." "$PROJECT_ROOT/deps/"
    cp -a "$cache_entry/_build/." "$PROJECT_ROOT/_build/"
    touch "$cache_entry/complete"
    echo "Restored warm cache $cache_key."
    ensure_mix_home
  else
    quiet_bootstrap "$cache_root/setup-$task_id.log" "Populating warm cache $cache_key"

    temporary_entry="$cache_root/entries/.${cache_key}.partial-$$"
    rm -rf "$temporary_entry"
    mkdir -p "$temporary_entry/deps" "$temporary_entry/_build"
    cp -a "$PROJECT_ROOT/deps/." "$temporary_entry/deps/"
    cp -a "$PROJECT_ROOT/_build/." "$temporary_entry/_build/"
    touch "$temporary_entry/complete"
    mv "$temporary_entry" "$cache_entry"
  fi
else
  quiet_bootstrap "$cache_root/setup-$task_id.log" "Dirty worktree: compiling privately"
fi

# Bootstrap may install the toolchain in its own subprocess; make it available
# in this setup process for database preparation and later lifecycle commands.
export PATH="$ELIXIR_DIR/bin:$OTP_DIR/bin:$PATH"

{
  printf 'export AGENT_TASK_ID=%q\n' "$task_id"
  printf 'export DATABASE_URL=%q\n' "$database_url"
  printf 'export MIX_DEPS_PATH=%q\n' "$PROJECT_ROOT/deps"
  printf 'export MIX_BUILD_PATH=%q\n' "$PROJECT_ROOT/_build"
  printf 'export MIX_HOME=%q\n' "$PROJECT_ROOT/.worktree-mix"
  printf 'export PORT=%q\n' "$port"
  printf 'export WORKTREE_PORT_LEASE=%q\n' "$port_lease"
  printf 'export WORKTREE_DATABASE=%q\n' "$database"
  printf 'export WORKTREE_DATABASE_LEASE=%q\n' "$database_lease"
  printf 'export SPACETRADERS_WORKTREE_CACHE_DIR=%q\n' "$cache_root"
  printf 'export SPACETRADERS_PORT_REGISTRY_DIR=%q\n' "$port_root"
} > "$PROJECT_ROOT/.worktree-env"

# Test database allocation is part of workspace preparation, not product
# verification. The gate receives an already-created and migrated database.
if ! (
  source "$PROJECT_ROOT/.worktree-env"
  MIX_ENV=test "$ELIXIR_DIR/bin/mix" ecto.create --quiet &&
    MIX_ENV=test "$ELIXIR_DIR/bin/mix" ecto.migrate --quiet
); then
  echo "Could not prepare the allocated test database: $database" >&2
  echo "Run scripts/teardown to release this workspace's allocations." >&2
  exit 1
fi

echo "Task $task_id is ready on port $port with database $database."
setup_complete=1
