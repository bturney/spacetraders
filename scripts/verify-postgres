#!/usr/bin/env bash
# Run the complete verification gate against PostgreSQL.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_toolchain.sh"

export DATABASE_URL="${DATABASE_URL:-postgres://postgres:postgres@localhost/spacetraders_test}"
export PORT="${PORT:-4003}"
MIX_ENV=postgres_test mix verify
