#!/usr/bin/env bash
# Opt-in real-surface verification: exercise the SpaceTraders API client
# against the live game (see scripts/verify_live.exs for the assertions).
#
# The canonical `scripts/verify` gate is hermetic and never touches the network,
# so it cannot catch API-contract drift between the bundled spec and the live
# game. Run this after changing lib/spacetraders/api.ex, the bundled spec, or
# the client's test fixtures. Requires outbound network access.
#
# Usage: scripts/verify-live
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_toolchain.sh"

if command -v mix >/dev/null 2>&1; then
  MIX=mix
elif [ -x "$ELIXIR_DIR/bin/mix" ]; then
  MIX="$ELIXIR_DIR/bin/mix"
  export PATH="$ELIXIR_DIR/bin:$OTP_DIR/bin:$PATH"
else
  echo "No Elixir toolchain found. Run scripts/bootstrap first." >&2
  exit 1
fi

"$MIX" run "$SCRIPT_DIR/verify_live.exs"
