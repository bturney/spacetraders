#!/usr/bin/env bash
# Release the test database worktree-setup allocated for this task.
#
# An allocated database is released when the task's checkout is torn down, the
# same way the task's port lease is released. Idempotent, and a no-op unless
# this task holds the database lease.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_toolchain.sh"

database="${WORKTREE_DATABASE:-}"
if [ "${WORKTREE_DATABASE_LEASE:-0}" != 1 ] || [ -z "$database" ]; then
  exit 0
fi

if [[ ! "$database" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]; then
  echo "Refusing to drop an unrecognised database name: $database" >&2
  exit 64
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "Warning: psql is unavailable; test database $database was not dropped." >&2
  echo "  Drop it with: psql <server-url> -c 'DROP DATABASE IF EXISTS \"$database\"'" >&2
  exit 0
fi

# Connect to a database other than the one being dropped, on the same server.
server_url="${DATABASE_URL:-postgres://postgres:postgres@localhost/spacetraders_test}"
admin_url="${server_url%/*}/postgres"

# WITH (FORCE) disconnects sessions a killed gate may have left behind, which
# would otherwise block the drop with 55006 object_in_use.
if ! psql "$admin_url" --no-psqlrc --quiet --set=ON_ERROR_STOP=1 \
  --command "DROP DATABASE IF EXISTS \"$database\" WITH (FORCE)" >/dev/null 2>&1; then
  echo "Warning: could not drop test database $database." >&2
  echo "  Drop it with: psql $admin_url -c 'DROP DATABASE IF EXISTS \"$database\" WITH (FORCE)'" >&2
fi
