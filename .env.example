# Deployment secrets for the SpaceTraders dashboard.
#
# Game tokens (AccountTokens, AgentTokens) are NEVER stored here — they live in
# the database, encrypted (ADR 0006). The seed script reads the seeded agent's
# token from SPACETRADERS_AGENT_TOKEN at seed time only (see priv/repo/seeds.exs).
#
# Copy to `.env` and fill in. This file is committed; `.env` is not.

# Signed/encrypted cookies. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# 32 bytes, base64 — used to encrypt game secrets at rest. Generate with:
#   mix run -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
ENCRYPTION_KEY=

# SQLite database path (production). Compose sets this to the persistent volume.
DATABASE_PATH=/etc/spacetraders/spacetraders.db

# Public host the dashboard is served on.
PHX_HOST=spacetraders.local

# Port to bind.
PORT=4000
